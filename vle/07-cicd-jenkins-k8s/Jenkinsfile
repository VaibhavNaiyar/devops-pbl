// VLE 7 - CI/CD: GitHub -> Jenkins -> test -> Docker build/push -> Kubernetes rolling deploy
pipeline {
  agent any
  options { timestamps(); timeout(time: 20, unit: 'MINUTES'); buildDiscarder(logRotator(numToKeepStr: '10')) }
  environment {
    APP_DIR   = 'vle/07-cicd-jenkins-k8s/app'
    K8S_DIR   = 'vle/07-cicd-jenkins-k8s/k8s'
    VERSION   = "1.0.${BUILD_NUMBER}"
  }
  stages {
    stage('Checkout') {
      steps { checkout scm; sh 'git log -1 --oneline' }
    }
    stage('Install & Unit Test') {
      steps { dir(env.APP_DIR) { sh 'npm ci && npm test' } }
    }
    stage('Build Image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          script { env.IMAGE = "${DH_USER}/pbl-shop:${VERSION}" }
          sh 'docker build -t $IMAGE -t ${IMAGE%:*}:latest $APP_DIR'
        }
      }
    }
    stage('Push Image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            # retry: Docker Desktop's registry proxy can drop uploads on flaky networks
            for t in $IMAGE ${IMAGE%:*}:latest; do
              for i in 1 2 3 4; do docker push $t && break; [ $i = 4 ] && exit 1; echo "push retry $i"; sleep 10; done
            done
          '''
        }
      }
    }
    stage('Deploy to Kubernetes') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            sed -e "s|IMAGE_PLACEHOLDER|$IMAGE|" -e "s|VERSION_PLACEHOLDER|$VERSION|" $K8S_DIR/deployment.yaml > /tmp/deploy.yaml
            kubectl apply -f /tmp/deploy.yaml
            kubectl apply -f $K8S_DIR/service.yaml
            kubectl -n shop rollout status deployment/shop --timeout=180s
            kubectl -n shop get pods -o wide
          '''
        }
      }
    }
    stage('Smoke Test') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            kubectl -n shop run smoke-$BUILD_NUMBER --rm -i --restart=Never --image=curlimages/curl -- \
              curl -fs http://shop.shop.svc.cluster.local/health | tee /tmp/health.json
            grep -q "$VERSION" /tmp/health.json
          '''
        }
      }
    }
  }
  post {
    failure {
      withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
        sh 'kubectl -n shop rollout undo deployment/shop || true'
      }
      echo 'Deployment failed - rolled back to previous revision'
    }
    success { echo "Deployed ${env.IMAGE} -> http://localhost:30080" }
    always  { sh 'docker logout || true' }
  }
}
