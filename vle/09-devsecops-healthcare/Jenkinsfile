// VLE 9 - Secure DevOps (DevSecOps) pipeline for a Healthcare system
// Security is "shifted left": every stage can fail the build before PHI-handling code reaches production.
pipeline {
  agent any
  options { timestamps(); timeout(time: 40, unit: 'MINUTES') }
  parameters {
    booleanParam(name: 'RUN_DEPENDENCY_CHECK', defaultValue: false, description: 'OWASP Dependency-Check (first run downloads the NVD database: 20+ min)')
  }
  // NOTE: Jenkins runs in a container and talks to the HOST docker daemon, so tool containers use
  // --volumes-from jenkins (same /var/jenkins_home paths) instead of -v $WORKSPACE:... bind mounts,
  // which would mount an empty host directory and silently scan nothing.
  environment {
    APP_DIR  = 'vle/09-devsecops-healthcare/app'
    K8S_DIR  = 'vle/09-devsecops-healthcare/k8s'
    SEC_DIR  = 'vle/09-devsecops-healthcare/security'
    VERSION  = "1.0.${BUILD_NUMBER}"
    SONAR_URL = 'http://sonarqube:9000'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('1. Secret scanning (Gitleaks)') {
      steps {
        sh '''
          docker run --rm --user 0 --volumes-from jenkins zricethezav/gitleaks:v8.21.2 detect \
            --source "$WORKSPACE" --config "$WORKSPACE/$SEC_DIR/.gitleaks.toml" --no-git \
            --report-format json --report-path "$WORKSPACE/gitleaks-report.json" --exit-code 1
        '''
      }
    }

    stage('2. Unit tests + coverage') {
      steps {
        dir(env.APP_DIR) {
          sh 'npm ci'
          sh 'node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.js && mkdir -p coverage && mv lcov.info coverage/'
        }
      }
    }

    stage('3. SCA - dependency vulnerabilities') {
      parallel {
        stage('npm audit') {
          steps { dir(env.APP_DIR) { sh 'npm audit --omit=dev --audit-level=high' } }
        }
        stage('OWASP Dependency-Check') {
          when { expression { params.RUN_DEPENDENCY_CHECK } }
          steps {
            sh '''
              mkdir -p odc-report
              docker run --rm --user 0 --volumes-from jenkins \
                -v odc-data:/usr/share/dependency-check/data owasp/dependency-check:latest \
                --scan "$WORKSPACE/$APP_DIR" --format HTML --format JSON --out "$WORKSPACE/odc-report" --project patient-api \
                --failOnCVSS 9 --disableYarnAudit || echo "ODC finished"
            '''
          }
        }
      }
    }

    stage('4. SAST (SonarQube) + Quality Gate') {
      steps {
        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
          sh '''
            # SonarQube needs 2-3 min after a restart; scanning earlier gives 404s on its API
            for i in $(seq 1 60); do curl -s $SONAR_URL/api/system/status | grep -q '"status":"UP"' && break; echo "waiting for SonarQube..."; sleep 5; done
            docker run --rm --user 0 --network kind --volumes-from jenkins -w "$WORKSPACE/$APP_DIR" sonarsource/sonar-scanner-cli \
              -Dsonar.projectBaseDir="$WORKSPACE/$APP_DIR" \
              -Dsonar.host.url=$SONAR_URL -Dsonar.token=$SONAR_TOKEN -Dsonar.qualitygate.wait=true
          '''
        }
      }
    }

    stage('5. Dockerfile lint (Hadolint)') {
      steps { sh 'docker run --rm -i hadolint/hadolint:latest-alpine < $APP_DIR/Dockerfile' }
    }

    stage('6. Build image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          script { env.IMAGE = "${DH_USER}/patient-api:${VERSION}" }
          sh 'docker build -t $IMAGE $APP_DIR'
        }
      }
    }

    stage('7. Container scan (Trivy)') {
      steps {
        sh '''
          trivy image --no-progress --format table -o trivy-image.txt $IMAGE
          trivy image --no-progress --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 $IMAGE
        '''
      }
    }

    stage('8. IaC / K8s manifest scan (Trivy config)') {
      steps { sh 'trivy config --severity HIGH,CRITICAL --exit-code 1 $K8S_DIR' }
    }

    stage('9. Push signed-off image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            for i in 1 2 3 4; do docker push $IMAGE && break; [ $i = 4 ] && exit 1; echo "push retry $i"; sleep 10; done
          '''
        }
      }
    }

    stage('10. Secure deploy') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG'),
                         string(credentialsId: 'patient-api-key', variable: 'API_KEY')]) {
          sh '''
            kubectl create namespace healthcare --dry-run=client -o yaml | kubectl apply -f -
            kubectl -n healthcare create secret generic patient-api-secret \
              --from-literal=api-key="$API_KEY" --dry-run=client -o yaml | kubectl apply -f -
            sed "s|IMAGE_PLACEHOLDER|$IMAGE|" $K8S_DIR/secure-deployment.yaml > /tmp/secure-deployment.yaml
            kubectl apply -f /tmp/secure-deployment.yaml --dry-run=server >/dev/null   # admission (PSA restricted) check first
            kubectl apply -f /tmp/secure-deployment.yaml
            kubectl apply -f $K8S_DIR/network-policy.yaml -f $K8S_DIR/rbac.yaml
            kubectl -n healthcare rollout status deployment/patient-api --timeout=180s
          '''
        }
      }
    }

    stage('11. DAST (OWASP ZAP baseline)') {
      steps {
        sh '''
          mkdir -p zap && chmod 777 zap
          docker run --rm --network kind --volumes-from jenkins ghcr.io/zaproxy/zaproxy:stable bash -c \
            "mkdir -p /zap/wrk && zap-baseline.py -t http://pbl-control-plane:30083/health -r zap-report.html -I; cp /zap/wrk/zap-report.html $WORKSPACE/zap/" || true
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: 'gitleaks-report.json,trivy-image.txt,odc-report/**,zap/**'
      publishHTML([allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'zap', reportFiles: 'zap-report.html', reportName: 'ZAP DAST Report'])
      publishHTML([allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'odc-report', reportFiles: 'dependency-check-report.html', reportName: 'OWASP Dependency-Check'])
      sh 'docker logout || true'
    }
    failure { echo 'Security gate failed - image NOT deployed. Check archived reports.' }
  }
}
