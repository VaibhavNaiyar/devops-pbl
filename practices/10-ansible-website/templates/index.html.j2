<!doctype html>
<html><head><meta charset="utf-8"><title>{{ site_title }}</title>
<style>body{font-family:system-ui;background:#0f172a;color:#e2e8f0;display:grid;place-items:center;height:100vh;margin:0}
.card{background:#1e293b;padding:2.5rem 3rem;border-radius:14px;box-shadow:0 10px 30px #0006}h1{color:#38bdf8;margin-top:0}</style></head>
<body><div class="card">
<h1>{{ site_title }}</h1>
<p>Deployed by <b>{{ student }}</b> using Ansible</p>
<p>Host: {{ ansible_hostname }} | IP: {{ ansible_default_ipv4.address | default('n/a') }}</p>
<p>OS: {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
<p>Deployed at: {{ ansible_date_time.iso8601 }}</p>
</div></body></html>
